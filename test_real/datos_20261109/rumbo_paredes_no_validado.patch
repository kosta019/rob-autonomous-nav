+def scan_rumbo(g_real_grados, n_rayos=360):
+    # Scan de un pasillo con dos paredes paralelas a X (1.65 m a un lado y 2.40 m al otro), con el robot girado
+    # g_real_grados respecto a X. Devuelve los ángulos y las distancias en el LiDAR
+    th_real = math.radians(g_real_grados)
+    a = np.radians(np.arange(n_rayos))
+    r = np.full(n_rayos, math.inf)
+    for i in range(n_rayos):
+        s = math.sin(a[i] + th_real)
+        if s > 0.2:
+            r[i] = 1.65 / s
+        elif s < -0.2:
+            r[i] = 2.40 / -s
+    return a, r
+
+
+def test_rumbo_paredes_encuentra_el_giro():
+    # El robot cree ir a rumbo 0 pero va a -5 grados: hay que sumarle -5
+    a, r = scan_rumbo(-5.0)
+    ok = r <= 3.2
+    g, n = rumbo_paredes(r[ok], a[ok], 0.0, math.radians(12.0), math.radians(0.5), 0.03, 30)
+    assert math.degrees(g) == pytest.approx(-5.0, abs=0.5)
+    assert n >= 30
+
+
+def test_rumbo_paredes_sin_paredes_no_corrige():
+    # 40 puntos sueltos, sin ninguna pared: g = 0
+    rng = np.random.default_rng(1)
