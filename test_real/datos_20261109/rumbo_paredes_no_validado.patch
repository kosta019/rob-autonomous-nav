+def rumbo_paredes(r, a, th, busqueda, paso, ancho, min_puntos):
+    # Error del rumbo con las paredes largas del pasillo, que son paralelas al eje X. r y a son las distancias y los
+    # ángulos del LiDAR (ya filtrados) y th el rumbo creído. Para cada giro g candidato se calcula la Y de cada punto
+    # respecto al robot, y = r * sin(th + g + a), y se cuentan los puntos por franjas de 'ancho'. Con el giro correcto,
+    # cada pared cae en muy pocas franjas: es el giro con mayor suma de cuadrados.
+    # Devuelve (g, n): g es lo que hay que sumar al rumbo y n los puntos en franjas con pared (4 o más). Si hay pocos, o
+    # si el mejor giro está en el borde de la búsqueda (no es un máximo de verdad), g = 0.
+    if len(r) == 0:
+        return 0.0, 0
+    franjas = np.arange(-4.0, 4.0 + ancho, ancho)
+    mejor, puntuacion, mejor_h = 0.0, -1.0, None
+    for g in np.arange(-busqueda, busqueda + paso / 2, paso):
+        h, _ = np.histogram(r * np.sin(th + g + a), bins=franjas)
+        s = float(np.sum(h.astype(float) ** 2))
+        if s > puntuacion:
+            mejor, puntuacion, mejor_h = float(g), s, h
+    n = int(np.sum(mejor_h[mejor_h >= 4]))
+    if n < min_puntos or abs(mejor) >= busqueda - paso / 2:
+        return 0.0, n
+    return mejor, n
+
