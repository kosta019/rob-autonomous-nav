<?xml version="1.0"?>
<!-- GENERADO por scripts/generar_mundo_lab.py a partir de esta plantilla. No editar worlds/laboratorio.sdf a mano. -->
<!-- Mundo del laboratorio: origen y ejes = los del enunciado (x = X, y = Y, z arriba). -->
<sdf version="1.8">
  <world name="laboratorio">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Mismos parámetros de física que el empty_world de turtlebot3_gazebo -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <scene>
      <shadows>false</shadows>
    </scene>
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>4.5 8.5 16 0 1.5707 0</pose>
      </camera>
    </gui>

    <!-- Suelo y luz definidos aquí (sin descargar nada de Gazebo Fuel) -->
    <light type="directional" name="sol">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>
    <model name="suelo">
      <static>true</static>
      <link name="l">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry></collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pared_0"><static>true</static><pose>-0.685 8.890 0.250 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.050 17.820 0.500</size></box></geometry></collision><visual name="v"><geometry><box><size>0.050 17.820 0.500</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual></link></model>
